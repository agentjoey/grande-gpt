{
  "name": "grande-gpt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "grande": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:selfhost-safe": "vitest run --exclude tests/sandbox.test.ts --exclude tests/runner.test.ts --exclude tests/server.test.ts --exclude tests/tools.test.ts --exclude tests/e2e.test.ts",
    "test:tool-contract": "vitest run tests/toolsetIdentity.test.ts tests/onboardingTools.test.ts",
    "typecheck": "tsc --noEmit",
    "ci:verify": "pnpm test:selfhost-safe && pnpm typecheck && pnpm test:tool-contract",
    "cli": "node --disable-warning=ExperimentalWarning src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.12.32",
    "jose": "^6.2.4",
    "yaml": "2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
